{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. mind-meld merges the states, webdav-clj makes the requests of
 ;; the WebDAV store and serves a store over WebDAV, and wary-fetch sends
 ;; the requests.
 :deps  {org.clojure/clojure     {:mvn/version "1.11.4"}
         dk.simongray/wary-fetch {:mvn/version "0.10.0"}
         dk.simongray/webdav-clj {:mvn/version "0.1.0"}
         dk.simongray/mind-meld  {:mvn/version "0.3.0"}}

 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test" "test/resources"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test          (the tests in Node)
  ;; clojure -M:cljs compile browser-test  (the tests in a browser)
  :cljs {:extra-paths   ["test" "test/resources"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
         :extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.3"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
